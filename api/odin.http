### Read the site basics - expect 200 and an object with name, tagline, phone, email, address,
### copyright, instagram, linkedin, logo_dark and logo_light
GET {{baseUrl}}/api/odin/site
Accept: application/json

### Read the home page's sections - expect 200 and an object with page and sections, the sections
### in the order the page shows them: hero, statistics, features, how_it_works, pitch, fda
GET {{baseUrl}}/api/odin/page?name=home
Accept: application/json

### Read the About page - expect 200 and two sections: intro and mission, which has an image and
### its image_alt
GET {{baseUrl}}/api/odin/page?name=about
Accept: application/json

### Read the contact block - expect 200 and five sections: intro, details, then phone, email and
### address, each holding the label for the site basic of the same name
GET {{baseUrl}}/api/odin/page?name=contact
Accept: application/json

### Ask for a page that does not exist - expect 404 and a message
GET {{baseUrl}}/api/odin/page?name=missing
Accept: application/json

### Read one image - expect 200 and the image
GET {{baseUrl}}/api/odin/image?name=logo-dark.svg

### Ask for an image that does not exist - expect 404 and a message
GET {{baseUrl}}/api/odin/image?name=missing.png
Accept: application/json
